<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EDGE LIGHT"
        android:textColor="#FF0000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: BAND HAI"
        android:textColor="#AAAAAA"
        android:textSize="15sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="1. Permission ON Karein"
        android:textColor="#FFFFFF"
        android:backgroundTint="#222222"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Color Chunein:"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnRed"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Red"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF0000"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnGreen"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Green"
            android:textColor="#000000"
            android:backgroundTint="#00FF00"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnBlue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Blue"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0066FF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnYellow"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Yellow"
            android:textColor="#000000"
            android:backgroundTint="#FFFF00"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnCyan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cyan"
            android:textColor="#000000"
            android:backgroundTint="#00FFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnPink"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Pink"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF00CC" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMulti"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="SAB RANG (Multi-Color Chuk-Bhuk)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#6600CC"
        android:layout_marginBottom="22dp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="LIGHT ON KAREIN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#FF0000" />

</LinearLayout>
